# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public site URL used in auth email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Event sources
TICKETMASTER_API_KEY=

# Email digests
RESEND_API_KEY=
DIGEST_FROM_EMAIL="Event Me AI <digest@yourdomain.com>"

# Inngest (not needed with the local dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Telemetry (Strands → OpenTelemetry). Local Jaeger via docker compose:
OTEL_SERVICE_NAME=event-me-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...   # e.g. Langfuse
# OTEL_CONSOLE_EXPORTER=true
